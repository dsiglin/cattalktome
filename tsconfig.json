{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "types": ["vitest/globals"],
    "skipLibCheck": true
  },
  "include": ["src", "test", "vite.config.ts"]
}
